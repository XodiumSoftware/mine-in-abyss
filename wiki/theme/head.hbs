{{!-- Social and search metadata. Everything here is static or derived from
     the book title, because mdBook has no per-chapter front-matter variables.
     The site origin is written out because `site-url` is not exposed to
     templates, and `og:image` must be absolute for embeds to load it. --}}

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ book_title }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://wiki.mine-in-abyss.cc/{{#if is_index}}{{else}}{{ path }}{{/if}}">
<meta property="og:image" content="https://wiki.mine-in-abyss.cc/img/og-image.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="The Mine in Abyss logo">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="https://wiki.mine-in-abyss.cc/img/og-image.png">
