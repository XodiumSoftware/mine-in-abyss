# Install `just` once: https://github.com/casey/just

[windows]
set shell := ["powershell.exe", "-NoProfile", "-Command"]

_default:
    @just --list

build:
    mdbook build

[unix]
open: build
    xdg-open book/index.html 2>/dev/null || open book/index.html 2>/dev/null || true

[windows]
open: build
    Start-Process book/index.html

serve:
    mdbook serve --open --port 3000

lint:
    npx markdownlint-cli2 --config .markdownlint.json "src/**/*.md"

lint-fix:
    npx markdownlint-cli2 --config .markdownlint.json --fix "src/**/*.md"

check-links:
    lychee --config lychee.toml "src/**/*.md"

check: lint build

clean:
    mdbook clean

[unix]
setup:
    cargo install mdbook
    cargo install mdbook-variables
    npm install -g markdownlint-cli2
    echo "✅ Setup complete!"

[windows]
setup:
    cargo install mdbook
    cargo install mdbook-variables
    npm install -g markdownlint-cli2
    Write-Host "✅ Setup complete!"
